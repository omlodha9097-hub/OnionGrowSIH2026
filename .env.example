# ==============================================================================
# Harvest Heist / OnionGrade AI — Environment Variables Configuration
# NOTE: ALL environment variables are OPTIONAL for the Vercel demo build!
# If unconfigured, the system automatically runs using built-in demo data,
# in-memory database fallback, and Vercel serverless native CV engine.
# ==============================================================================

# Database Connection (Optional)
# MongoDB connection string for persistent storage.
# If omitted/not set, the app defaults to zero-config in-memory demo database.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/harvest_heist

# Python AI Computer Vision Microservice (Optional)
# External URL for Python YOLOv8 microservice endpoint.
# If omitted/unreachable, Vercel deployment automatically falls back to Node Native Analysis Engine.
# AI_SERVICE_URL=http://127.0.0.1:8088/analyze
# MODEL_INFO_URL=http://127.0.0.1:8088/model-info

# Twilio SMS Notifications (Optional)
# Credentials for automated SMS dispatch of grading reports and DBT payouts to farmers.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# Security & Authentication (Optional)
# Secret key for JWT token signing in administrative routes.
# JWT_SECRET=super-secret-harvest-heist-key-2026

# Server Port (Optional for local Express server execution)
# PORT=5001
